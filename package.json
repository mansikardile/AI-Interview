{
  "name": "interviewiq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:ollama": "node --env-file-if-exists=.env.local --import=tsx scripts/ollama-smoke.ts",
    "postinstall": "node scripts/prepare-monitoring-assets.mjs",
    "prepare:monitoring": "node scripts/prepare-monitoring-assets.mjs",
    "predev": "npm run prepare:monitoring",
    "prebuild": "npm run prepare:monitoring",
    "test:monitoring": "vitest run tests/monitoring",
    "test:monitoring:smoke": "node --import=tsx scripts/monitoring-smoke.ts",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ai": "vitest run tests/intelligence.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file-if-exists=.env.local --import=tsx scripts/migrate.ts",
    "worker:dev": "node --env-file-if-exists=.env.local --import=tsx src/workers/temporal/worker.ts",
    "temporal:smoke": "node --env-file-if-exists=.env.local --import=tsx scripts/temporal-smoke.ts",
    "test:smoke": "node --import=tsx scripts/http-smoke.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@ricky0123/vad-web": "0.0.31",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "next": "16.4.3",
    "onnxruntime-web": "1.30.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
