# Default startup/fixtures need no account or database. Saved interview UI requires camera + microphone.
AI_PROVIDER=mock
## For local real inference: AI_PROVIDER=ollama (no Jarvis key needed).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:e2b-mlx
SESSION_STORE=memory

# Owner B: opt-in server-only model configuration. Verify the exact model ID in your account.
JARVISLABS_API_KEY=
JARVISLABS_BASE_URL=https://models.jarvislabs.net/v1
# Required for live mode: copy the exact Gemma 4 API model ID from your JarvisLabs dashboard.
# Display names and Hugging Face repository names are not guaranteed API IDs.
JARVISLABS_MODEL=

# Owner D: run infra/compose.yaml and npm run db:migrate before using postgres.
DATABASE_URL=postgresql://interviewiq:interviewiq_local@localhost:5432/interviewiq

# Owner D: optional separate worker. Not wired into session routes yet.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=interviewiq

# Optional SRE lab foundation. No Nudgebee deployment is bundled.
NUDGEBEE_BASE_URL=
