# Default: no account, database, microphone or camera required.
AI_PROVIDER=mock
SESSION_STORE=memory

# Owner B: opt-in server-only model configuration. Verify the exact model ID in your account.
JARVISLABS_API_KEY=
JARVISLABS_BASE_URL=https://models.jarvislabs.net/v1
JARVISLABS_MODEL=gemma-4-26b-a4b-it

# Owner D: run infra/compose.yaml and npm run db:migrate before using postgres.
DATABASE_URL=postgresql://interviewiq:interviewiq_local@localhost:5432/interviewiq

# Owner D: optional separate worker. Not wired into session routes yet.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=interviewiq

# Optional SRE lab foundation. No Nudgebee deployment is bundled.
NUDGEBEE_BASE_URL=
